<script src="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.js"></script>
<link href="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@turf/turf@7.4.0/turf.min.js"></script>

{% assign satellite_icon="data:image/svg+xml;base64," %}
{% assign custom_fields_values=trmnl.plugin_settings.custom_fields_values %}

<!-- <div class="layout image-dither" id="map"></div> -->

<div class="layout">
  <div id="map" class="map stretch w--full rounded--base"></div>
</div>
<div class="title_bar">
  <!-- class="image--adaptive" doesn't seems to work here... -->
  <img class="image" src="{{ satellite_icon }}">
  <span class="title" id="satellite-name"></span>
  <span class="instance" id="data-time"></span>
</div>

<script type="module">
  import { Satellite } from 'https://cdn.jsdelivr.net/npm/ootk/+esm';

  // Tunable hours variables
  const PAST_HOURS = {{ custom_fields_values.trajectory_past }};
  const FUTURE_HOURS = {{ custom_fields_values.trajectory_future }};  

  // Split trajectory lines across the Antimeridian (+180/-180 longitude jump) to avoid continuous horizontal map lines
  function buildAntimeridianSplitSegments(rawPoints) {
    const segments = [];
    let currentSegment = [];

    for (let i = 0; i < rawPoints.length; i++) {
      const pt = rawPoints[i];
      const coord = [pt.lon, pt.lat]; // Turf/GeoJSON uses [lon, lat]

      if (currentSegment.length > 0) {
        const prevLon = currentSegment[currentSegment.length - 1][0];
        // If longitude jumps across antimeridian (>180 deg change)
        if (Math.abs(pt.lon - prevLon) > 180) {
          if (currentSegment.length > 1) {
            segments.push(currentSegment);
          }
          currentSegment = [];
        }
      }
      currentSegment.push(coord);
    }

    if (currentSegment.length > 1) {
      segments.push(currentSegment);
    }

    return segments;
  }

  function createGeoJSONCollection(rawPoints) {
    const lineSegments = buildAntimeridianSplitSegments(rawPoints);
    const lineFeatures = lineSegments.map(seg => turf.lineString(seg));
    return turf.featureCollection(lineFeatures.map(f => turf.cleanCoords(f)));
  }

  // Calculate and Render Trajectory
  function runPropagationAndRender() {    
    const now = Date.now();
    const startTime = now - (PAST_HOURS * 60 * 60 * 1000);
    const endTime = now + (FUTURE_HOURS * 60 * 60 * 1000);
    const stepMs = 60 * 1000; // 1-minute steps

    const pastPoints = [];
    const futurePoints = [];

    document.getElementById("satellite-name").innerHTML = `{{ ALT_NAME }}`;

    if (`{{ STATUS }}` == 'D') {
      document.getElementById("data-time").innerHTML = "Decayed";
      return;
    } else {
      document.getElementById("data-time").innerHTML = "{{ OWNER }}";
    }

    const satellite = new Satellite({ tle1: `{{ TLE_LINE_1 }}`, tle2: `{{ TLE_LINE_2 }}` });

    // 1. Calculate positions via OOTK
    for (let t = startTime; t <= endTime; t += stepMs) {
      const date = new Date(t);
      const lla = satellite.lla(date);
      const pt = {
        timestamp: date.toISOString(),
        lat: parseFloat(lla.lat.toFixed(4)),
        lon: parseFloat(lla.lon.toFixed(4)),
        alt: parseFloat(lla.alt.toFixed(2))
      };

      if (t <= now) {
        pastPoints.push(pt);
      }
      if (t >= now) {
        futurePoints.push(pt);
      }
    }

    const pastCollection = createGeoJSONCollection(pastPoints);
    const futureCollection = createGeoJSONCollection(futurePoints);

    // Combine features for total bounds
    const combinedFeatures = [...pastCollection.features, ...futureCollection.features];
    const combinedCollection = turf.featureCollection(combinedFeatures);
    const bbox = turf.bbox(combinedCollection);

    // Render Past Source & Layer
    if (map.getSource('iss-trajectory-past')) {
      map.getSource('iss-trajectory-past').setData(pastCollection);
    } else {
      map.addSource('iss-trajectory-past', { type: 'geojson', data: pastCollection });
      map.addLayer({
        id: 'iss-trajectory-past-line',
        type: 'line',
        source: 'iss-trajectory-past',
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': '#000000', 'line-width': 2, 'line-opacity': 0.95 }
      });
    }

    // Render Future Source & Layer (Dashed)
    if (map.getSource('iss-trajectory-future')) {
      map.getSource('iss-trajectory-future').setData(futureCollection);
    } else {
      map.addSource('iss-trajectory-future', { type: 'geojson', data: futureCollection });
      map.addLayer({
        id: 'iss-trajectory-future-line',
        type: 'line',
        source: 'iss-trajectory-future',
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: {
          'line-color': '#000000',
          'line-width': 2,
          'line-opacity': 0.85,
          'line-dasharray': [3, 3]
        }
      });
    }

    // Render Current Position Marker
    const latestPoint = pastPoints[pastPoints.length - 1];

    // Calculate heading using Turf.js bearing between last two points
    const prevPoint = pastPoints.length > 1 ? pastPoints[pastPoints.length - 2] : latestPoint;
    const bearing = turf.bearing(
      [prevPoint.lon, prevPoint.lat],
      [latestPoint.lon, latestPoint.lat]
    );

    map.fitBounds([[bbox[0], bbox[1]], [bbox[2], bbox[3]]], {
      animate: false,
      padding: 40,
      maxZoom: 2
    });

    const currentGeoJSON = {
      type: 'FeatureCollection',
      features: [{
        type: 'Feature',
        geometry: {
          type: 'Point',
          coordinates: [latestPoint.lon, latestPoint.lat]
        },
        properties: {
          bearing: bearing
        }
      }]
    };

    const updateCurrentLayer = () => {
      if (map.getSource('iss-current')) {
        map.getSource('iss-current').setData(currentGeoJSON);
      } else {
        map.addSource('iss-current', { type: 'geojson', data: currentGeoJSON });
        map.addLayer({
          id: 'iss-current-layer',
          type: 'symbol',
          source: 'iss-current',
          layout: {
            'icon-image': 'satellite-icon',
            'icon-size': 48 / 512,
            'icon-rotate': ['get', 'bearing'],
            'icon-rotation-alignment': 'map',
            'icon-allow-overlap': true,
            'icon-ignore-placement': true
          }
        });
      }
    };

    if (!map.hasImage('satellite-icon')) {
      const img = new Image();
      img.onload = () => {
        map.addImage('satellite-icon', img);
        updateCurrentLayer();
      };
      img.src = `{{ satellite_icon }}`;
    } else {
      updateCurrentLayer();
    }
  }

  // Wait for MapLibre and the framework TRMNLMaps helper (bundled in the
  // plugin runtime), then build the map from the live screen.
  function whenReady(cb) {
    var tries = 0;
    (function attempt() {
      if (window.TRMNLMaps && window.maplibregl) return cb();
      if (++tries > 200) return;
      setTimeout(attempt, 50);
    })();
  }


  let map, trajectoryLayerGroup, currentMarkerLayer;

  function create_map() {
    whenReady(function () {
      var el = "map";
      // watch() rebuilds on device/scale/mode/dark/theme change; options() carries
      // the style for the preset, painted from the live screen.
      TRMNLMaps.watch(el, function () {
        map = new maplibregl.Map(TRMNLMaps.options({
          el: el, preset: "streets"
        }), {
          center: [121.011756, 24.769163],
          zoom: 0,
          minZoom: 0,
          renderWorldCopies: true
        });

        map.on('load', () => {
          runPropagationAndRender();
        });

        return map;
      });
    });

  }

  create_map();
</script>


